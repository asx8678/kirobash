      - "*eksctl delete*"
      - "*eksctl deregister*"
      - "*cdk destroy*"
      - "*cdk deploy*"
      - "*sam delete*"
      - "*sam deploy*"
      - "*sam sync*"
      - "*serverless remove*"
      - "*sls remove*"
      - "*kops delete*"
