  # ---------------------------------------------------------------- k8s destructive: ask
  # (kiro-guard blocks these on remote clusters; on local kind/minikube you get a prompt)
  - capability: shell
    match:
      - "*kubectl delete *"
      - "*kubectl * delete *"
      - "*kubectl drain *"
