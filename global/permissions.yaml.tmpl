# kiro-pack permissions for Kiro CLI v3  ->  ~/.kiro/settings/permissions.yaml
# Effects: deny > ask > allow. The most restrictive matching rule wins across all scopes,
# so a deny here cannot be overridden by an allow in a workspace, agent or session.
# Shell patterns: '*' matches any characters; compound commands (; && || |) are split
# and each part is checked separately. __HOME__ is replaced by the installer.
rules:
  # ---------------------------------------------------------------- protect the guard + creds
  - capability: fs_write
    match:
      - "__HOME__/.kiro/hooks/**"
      - "__HOME__/.kiro/settings/**"
      - "__HOME__/.kiro/workspace-roots/**"
      - "__HOME__/.kube/**"
      - "__HOME__/.azure/**"
      - "__HOME__/.azure-kiro/**"
      - "__HOME__/.aws/**"
      - "__HOME__/.aws-kiro/**"
      - "__HOME__/.kiro/steering/**"
      - "__HOME__/.kiro/skills/**"
      - "__HOME__/.kiro/agents/**"
      - "__HOME__/.kiro/lib/**"
      - "__HOME__/.local/bin/kiro-*"
      - "__HOME__/.ssh/**"
      - "**/.kiro/hooks/**"
    effect: deny
  - capability: fs_write
    match:
      - "**/.kiro/steering/**"
      - "**/.kiro/agents/**"
      - "**/.kiro/skills/**"
      - "**/.kiro/settings/**"
      - "**/AGENTS.md"
      - "**/.kiroignore"
      - "**/.github/workflows/**"
      - "**/.gitlab-ci.yml"
      - "**/azure-pipelines*.yml"
    effect: ask
  - capability: fs_read
    match:
      - "__HOME__/.kube/**"
      - "__HOME__/.azure/**"
      - "__HOME__/.azure-kiro/**"
      - "__HOME__/.aws/**"
      - "__HOME__/.aws-kiro/**"
    effect: deny

  # Kiro saves a tool result of 30,000 characters or more to a file in its session folder and tells
  # the agent to read it from there: no prompt for reading back its own output.
  - capability: fs_read
    match:
      - "__HOME__/.kiro/sessions/**/tool-outputs/**"
    effect: allow

  # ---------------------------------------------------------------- research tools: no prompts
  - capability: web_search
    effect: allow
  # web_fetch rules are matched against the URL's hostname only (no scheme, port or path)
  - capability: web_fetch
    match: ["*169.254.169.254*", "*metadata.google.internal*", "*metadata.azure.com*", "*169.254.170.2*",
            "*localhost*", "*127.0.0.1*", "*0.0.0.0*", "*[::1]*", "*.internal", "*.local"]
    effect: deny
  - capability: web_fetch
    effect: allow
  # the pack's helpers (fact-check: web lookups; scout and skeptic: read-only) run without a prompt
  - capability: subagent
    match: ["fact-check", "scout", "skeptic"]
    effect: allow
  - capability: skill
    effect: allow

  # ---------------------------------------------------------------- destructive: always deny
  - capability: shell
    match:
      # Azure CLI / azd / azcopy / PowerShell
      - "*az * delete*"
      - "*az * purge*"
      - "*az * deallocate*"
      - "*az * stop*"
      - "*az * reimage*"
      - "*az * redeploy*"
      - "*az * regenerate*"
      - "*az * revoke*"
      - "*az * keys renew*"
      - "*az * failover*"
      - "*az * swap*"
      - "*az * untag*"
      - "*az * run-command invoke*"
      - "*--mode Complete*"
      - "*--mode complete*"
      - "*--action-on-unmanage delete*"
      - "*az rest*--method delete*"
      - "*az rest*-m delete*"
      - "*--delete-destination*true*"
      - "*azd down*"
      - "*azcopy remove*"
      - "*azcopy rm *"
      - "*Remove-Az*"
      - "*-EncodedCommand*"
      # AWS CLI / EKS tooling
      - "*aws * delete-*"
      - "*aws * terminate-*"
      - "*aws * deregister-*"
      - "*aws * purge-*"
      - "*aws * reboot-*"
      - "*aws * stop-*"
